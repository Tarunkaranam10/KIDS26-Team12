#!/bin/bash
#BSUB -J "kids26_loco[1-30]%4"
#BSUB -q biohackathon
#BSUB -n 4
#BSUB -R "span[hosts=1] rusage[mem=60GB]"
#BSUB -M 240GB
#BSUB -W 8:00
#BSUB -o logs/loco_%J_%I.out
#BSUB -e logs/loco_%J_%I.err
# =============================================================================
# KIDS26 Team 12 - nested leave-one-cancer-out as a 30-task LSF array.
# =============================================================================
#
# WHAT THIS RUNS
#   One array task per development cancer type. Each task holds out its own
#   cancer, tunes hyperparameters on cancer-grouped inner folds built only from
#   the remaining types, fits an elastic net, and predicts the held-out type.
#   Tasks are fully independent - no task reads another task's output.
#
# WHY AN ARRAY INSTEAD OF ONE LONG JOB
#   Measured end-to-end on fold 1 / ACC (job 323075937, noderome117):
#       fit_en            53.2 min  (includes preprocessing AND glmnet)
#       peak memory      173 GB
#       wall time         55.4 min
#   Thirty folds run serially is therefore roughly 28 h. Running them
#   concurrently collapses that to a few waves.
#
# -------------------------------------------------------------------------
# RESOURCE CHOICES - all measured on a real fold, not guessed
# -------------------------------------------------------------------------
#   [1-30]      One task per development cancer type. If the cohort ever gains
#               or loses a type this range MUST be updated; loco_merge.R will
#               refuse to merge if a fold is missing, which is the safety net.
#
#   *** rusage[mem] ON THIS CLUSTER IS PER SLOT, NOT PER JOB. ***#
#   This is the single most important thing to understand before editing the
#   numbers below. LSF multiplies rusage[mem] by the slot count from -n. An
#   earlier version of this file requested -n 8 with rusage[mem=230GB], which
#   LSF read as 8 x 230 = 1,840 GB. No node in the queue has that much, so all
#   30 tasks sat PENDING forever with:
#       "Job's requirements for resource reservation not satisfied (Resource: mem)"
#   The job does not fail; it simply never starts, which is easy to mistake for
#   a busy queue.
#
#   The rule: rusage[mem] x (-n) must fit on ONE node.
#
#   -n 4        Four slots. The work is memory-bound, not CPU-bound: the dry run
#               used 3,360 s of CPU over 3,324 s of wall time, so barely more
#               than one core was ever busy. Fewer slots also means a smaller
#               per-slot memory figure is needed to reach the same total, which
#               makes the job easier to schedule.
#
#   rusage[mem=60GB]
#               60 GB x 4 slots = 240 GB reserved per task. The dry run peaked
#               at 173 GB (Max Memory 173,252 MB), so this is ~39% headroom.
#               Larger cancer types train on slightly more rows than ACC did, so
#               the peak will drift upward a little.
#
#   -M 240GB    The hard kill limit, expressed as the whole-job total. Keep this
#               equal to rusage[mem] x (-n) so the reservation and the limit
#               agree.
#
#   %4          Run at most 4 tasks concurrently. At 240 GB per task that is
#               960 GB, which fits within noderome117 (1,003 GB) alone and
#               comfortably within nodegpu217 (1,435 GB). Across both nodes LSF
#               can place these wherever there is room.
#
#               Expect 8 waves x ~1 h, so roughly 8 h wall time. That is the
#               honest cost of a 173 GB working set on a two-node queue.
#               Raise to %6 only after confirming both nodes are idle
#               (6 x 240 GB = 1,440 GB needs essentially all of nodegpu217).
#               Lower to %2 if other teams are queued behind you.
#
#   -W 8:00     The dry run took 55 min on the smallest development type. Larger
#               folds and a busier node will be slower, so 8 h is deliberate
#               insurance. LSF kills at the wall limit; over-requesting time is
#               cheap while under-requesting loses the entire task.
#
# SUBMIT
#   bsub < scripts/lsf_loco_array.bsub
#
# MONITOR
#   bjobs -A                       # array summary: done / pending / running
#   bjobs -l <JOBID> | head -40    # detail
#   tail -f logs/loco_<JOBID>_1.out
#
# AFTER ALL TASKS COMPLETE
#   Rscript scripts/loco_merge.R results/loco_run01 data/processed/master_samples.tsv
#
#   The merge performs the pooled tissue-mean null, within-tissue permutation
#   and purity-stratified analyses. Those are the results that determine whether
#   there is a finding at all, and they cannot run per fold.
#
# RERUNNING A FAILED TASK
#   Array indices are independent, so a single failure is cheap to repair:
#       bsub -q biohackathon -n 4 -R "span[hosts=1] rusage[mem=60GB]" -M 240GB -W 8:00 \
#            -o logs/loco_rerun_%J.out -e logs/loco_rerun_%J.err \
#            "cd $PWD && Rscript scripts/loco_one_fold.R data/processed/beta.tsv \
#             data/processed/master_samples.tsv results/loco_run01 <INDEX>"
# =============================================================================

set -euo pipefail

REPO=/research/groups/shelagrp/home/esavage/KIDS26/KIDS26-Team12
BETA=data/processed/beta.tsv
META=data/processed/master_samples.tsv
OUT=results/loco_run01

cd "$REPO"
mkdir -p logs "$OUT/folds"

echo "=== array job ${LSB_JOBID} task ${LSB_JOBINDEX} on $(hostname) ==="
echo "started: $(date)"
free -g | head -2
echo

# Pin thread counts to the slots LSF granted. Without this, R's BLAS would spawn
# one thread per physical core (up to 128 on nodegpu217), oversubscribing our
# allocation, slowing this job down and disrupting others on the same host.
export OMP_NUM_THREADS=${LSB_DJOB_NUMPROC:-4}
export OPENBLAS_NUM_THREADS=${LSB_DJOB_NUMPROC:-4}
export MKL_NUM_THREADS=${LSB_DJOB_NUMPROC:-4}

# LSB_JOBINDEX is 1-based and maps directly onto the 1-based fold index, which
# indexes the sorted development cancer types.
Rscript scripts/loco_one_fold.R "$BETA" "$META" "$OUT" "${LSB_JOBINDEX}"

echo
echo "finished: $(date)"
